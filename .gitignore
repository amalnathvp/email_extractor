backend/storage/images/*
!backend/storage/images/.gitkeep
backend/storage/documents/*
!backend/storage/documents/.gitkeep
backend/storage/spreadsheets/*
!backend/storage/spreadsheets/.gitkeep
backend/storage/presentations/*
!backend/storage/presentations/.gitkeep
backend/storage/others/*
