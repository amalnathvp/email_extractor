# FileFlow - Environment Configuration
PROJECT_NAME="FileFlow - Email Attachment Processing System"
DEBUG=false

# IMAP Configuration (Zoho Mail)
EMAIL_HOST=imap.zoho.in
EMAIL_PORT=993
EMAIL_USERNAME=amalnathvp@zohomail.in
EMAIL_PASSWORD=your_zoho_app_password
EMAIL_USE_SSL=true
EMAIL_FOLDER=INBOX
EMAIL_SEARCH_CRITERIA=UNSEEN
MARK_SEEN_ON_PROCESS=true

# Database (PostgreSQL or SQLite)
DATABASE_URL=sqlite:///./storage/email_manager.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/email_manager

# Storage Path (Absolute or relative to backend root)
STORAGE_PATH=./storage
MAX_FILE_SIZE_BYTES=52428800

# Automated Background Polling
AUTO_POLL_ENABLED=false
POLL_INTERVAL_SECONDS=120
